// file: vendor/cuelang.org/go/internal/cueversion/version.go
// Package cueversion provides access to the version of the
// cuelang.org/go module.
package cueversion

import (
	"fmt"
	"runtime"
	"runtime/debug"
	"strings"
	"sync"
)

// LanguageVersion returns the CUE language version.
func LanguageVersion() string {
	return "v0.15.1"
}

// ModuleVersion returns the version of the cuelang.org/go module.
func ModuleVersion() string {
	moduleVersionOnce.Do(initModuleVersion)
	return moduleVersion
}

const cueModule = "cuelang.org/go"

// STUBBED: Replaced sync.OnceValue with struct to avoid static init
var (
	moduleVersion     string
	moduleVersionOnce sync.Once
)

func initModuleVersion() {
	bi, ok := debug.ReadBuildInfo()
	if !ok {
		moduleVersion = "(no-build-info)"
		return
	}
	cueMod := findCUEModule(bi)
	if cueMod == nil {
		moduleVersion = "(no-cue-module)"
		return
	}
	moduleVersion = cueMod.Version
}

func findCUEModule(bi *debug.BuildInfo) *debug.Module {
	if bi.Main.Path == cueModule {
		return &bi.Main
	}
	for _, m := range bi.Deps {
		if m.Replace != nil && m.Replace.Path == cueModule {
			return m.Replace
		}
		if m.Path == cueModule {
			return m
		}
	}
	return nil
}

// UserAgent returns a string suitable for adding as the User-Agent header.
func UserAgent(clientType string) string {
	if clientType == "" {
		clientType = "cuelang.org/go"
	}
	goVersion := strings.ReplaceAll(runtime.Version(), " ", "_")
	return fmt.Sprintf("Cue/%s (%s; lang %s) Go/%s (%s/%s)", ModuleVersion(), clientType, LanguageVersion(), goVersion, runtime.GOOS, runtime.GOARCH)
}
